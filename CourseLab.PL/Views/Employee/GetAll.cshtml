@using CourseLab.BLL.ModelVM.EmployeeVM

@model List<GetAllEmployeeVM>

<div class="employees-page">
    <div class="page-header">
        <div>
            <h1>Employees</h1>
            <p>Manage your employees</p>
        </div>

        <a asp-action="Create" asp-controller="Employee" class="btn-primary-custom">
            + Add Employee
        </a>
    </div>


    <div class="employee-grid">
        @foreach (var item in Model)
        {
            <div class="employee-card">

                @if (!string.IsNullOrEmpty(item.ImagePath))
                {
                    <img src="@item.ImagePath" alt="@item.Name" class="employee-avatar" />
                }
                else
                {
                    <div class="employee-avatar">
                        @item.Name.Substring(0, 1).ToUpper()
                    </div>
                }


                <div class="employee-info">
                    <h3>@item.Name</h3>
                    <p>Employee ID: #@item.Id</p>
                    <p>Age: @item.Age</p>
                </div>

                <div class="employee-actions">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-details">
                        Details
                    </a>

                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-edit">
                        Edit
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-delete" onclick="return confirm('Are you sure you want to delete this employee?');">
                        Delete
                    </a>
                </div>

            </div>
        }

    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/employee-forms.css" />
    <link rel="stylesheet" href="~/css/authentication.css" />
    <link rel="stylesheet" href="~/css/employee.css" />
    <link rel="stylesheet" href="~/css/employee-details.css" />
    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/css/theme-page.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
}
