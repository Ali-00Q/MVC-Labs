@using CourseLab.DAL.Entities

@model Employee

<div class="details-page">
    <div class="details-card">
        <div class="details-header">
            <h2>Employee From Session</h2>
            <p>This employee was retrieved from the current Session.</p>
        </div>

        @if (Model != null)
        {
            <div class="session-success">
                <i class="bi bi-check-circle-fill"></i>
                Employee successfully retrieved from Session.
            </div>

            <div class="details-content">

                <div class="details-image-section">
                    <img id="imgPreview" src="@Model.ImagePath" alt="Employee Image" class="details-image" />
                </div>

                <div class="details-info">

                    <div class="info-item">
                        <span class="info-label">Employee ID</span>
                        <span class="info-value">#@Model.Id</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Name</span>
                        <span class="info-value">@Model.Name</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Age</span>
                        <span class="info-value">@Model.Age</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Salary</span>
                        <span class="info-value">
                            @(Model.Salary.HasValue ? Model.Salary.Value.ToString("N2") : "Not specified")
                        </span>
                    </div>

                    <div class="details-buttons">
                        <a asp-action="GetAll" class="btn-primary-custom">
                            Back to Employees
                        </a>
                    </div>

                </div>

            </div>
        }
        else
        {
            <div class="session-warning">
                <i class="bi bi-exclamation-circle-fill"></i>

                <div>
                    <strong>No employee in Session</strong>
                    <p>
                        There is currently no employee stored in Session.
                    </p>
                </div>
            </div>

            <a asp-action="GetAll" class="btn-secondary-custom">
                Go to Employees
            </a>
        }

    </div>

</div>


@section Styles {
    <link rel="stylesheet" href="~/css/employee-forms.css" />
    <link rel="stylesheet" href="~/css/authentication.css" />
    <link rel="stylesheet" href="~/css/employee.css" />
    <link rel="stylesheet" href="~/css/employee-details.css" />
    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/css/theme-page.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
}