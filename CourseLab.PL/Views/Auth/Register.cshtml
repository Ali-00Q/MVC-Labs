@using CourseLab.BLL.ModelVM.AuthVm

@model RegisterVM

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create an Account";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-body p-4 p-sm-5">

                    <!-- Header -->
                    <div class="text-center mb-4">
                        <h2 class="fw-bold mb-2">
                            Sign Up
                        </h2>
                    </div>


                    <form asp-action="Register" asp-controller="Auth" method="post" autocomplete="off">

                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"> </div>


                        <!-- Name -->
                        <div class="auth-input mb-3">
                            <i class="bi bi-person-fill"></i>
                            <input asp-for="Name" type="text" placeholder="Full Name" />
                        </div>

                        <span asp-validation-for="Name" class="text-danger small"></span>


                        <!-- Email -->
                        <div class="auth-input mb-3">
                            <i class="bi bi-envelope-fill"></i>
                            <input asp-for="Email" type="email" placeholder="Email Address" />
                        </div>

                        <span asp-validation-for="Email" class="text-danger small"> </span>


                        <!-- Password -->
                        <div class="auth-input mb-3">
                            <i class="bi bi-lock-fill"></i>
                            <input asp-for="Password" type="text" placeholder="Password" />
                        </div>

                        <span asp-validation-for="Password" class="text-danger small"> </span>


                        <!-- Confirm Password -->
                        <div class="auth-input mb-4">
                            <i class="bi bi-lock-fill"></i>
                            <input asp-for="ConfirmPassword" type="text" placeholder="Confirm Password" />
                        </div>

                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>


                        <!-- Create Account -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                                Create Account
                            </button>
                        </div>


                        <!-- Login -->
                        <div class="text-center mt-3">
                            <span class="text-muted">
                                Already have an account?
                            </span>

                            <a asp-action="Login" asp-controller="Auth" class="text-decoration-none fw-semibold">
                                Sign In
                            </a>
                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

@section Styles {
    <link rel="stylesheet" href="~/css/employee-forms.css" />
    <link rel="stylesheet" href="~/css/authentication.css" />
    <link rel="stylesheet" href="~/css/employee.css" />
    <link rel="stylesheet" href="~/css/employee-details.css" />
    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/css/theme-page.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
}