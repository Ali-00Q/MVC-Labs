@using CourseLab.BLL.ModelVM.AuthVm

@model LoginVM

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-body p-4 p-sm-5">

                    <div class="text-center mb-4">
                        <h2 class="fw-bold mb-2">
                            Welcome Back
                        </h2>
                    </div>


                    <form asp-action="Login" asp-controller="Auth" method="post" autocomplete="off">
                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>


                        <!-- Email -->
                        <div class="login-input mb-3">
                            <i class="bi bi-envelope-fill"></i>
                            <input asp-for="Email" type="email" />
                        </div>

                        <span asp-validation-for="Email" class="text-danger small"></span>


                        <!-- Password -->
                        <div class="login-input mb-3">
                            <i class="bi bi-lock-fill"></i>
                            <input asp-for="Password" type="password" id="loginPassword" placeholder="Password" />
                            <button type="button" class="password-eye" onclick="togglePassword()">
                                <i class="bi bi-eye-slash-fill" id="passwordIcon"></i>
                            </button>
                        </div>

                        <span asp-validation-for="Password" class="text-danger small"></span>


                        <!-- Login Button -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                                Sign In
                            </button>
                        </div>


                        <!-- Register -->
                        <div class="text-center mt-3">
                            <span class="text-muted">
                                Don't have an account?
                            </span>

                            <a asp-action="Register" asp-controller="Auth" class="text-decoration-none fw-semibold">
                                Create Account
                            </a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function togglePassword() {

            const password = document.getElementById("loginPassword");
            const icon = document.getElementById("passwordIcon");

            if (password.type === "password") {

                password.type = "text";

                icon.classList.remove("bi-eye-slash-fill");
                icon.classList.add("bi-eye-fill");

            }
            else {

                password.type = "password";

                icon.classList.remove("bi-eye-fill");
                icon.classList.add("bi-eye-slash-fill");

            }
        }

    </script>
}


@section Styles {
    <link rel="stylesheet" href="~/css/employee-forms.css" />
    <link rel="stylesheet" href="~/css/authentication.css" />
    <link rel="stylesheet" href="~/css/employee.css" />
    <link rel="stylesheet" href="~/css/employee-details.css" />
    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/css/theme-page.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
}